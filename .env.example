# FluentDB server configuration
# Port for the local server (UI + API)
FLUENTDB_PORT=4983

# Data directory (connections, query history). Default: ~/.fluentdb
# FLUENTDB_DATA_DIR=/path/to/dir

# Encryption key override for the credentials store (hex, 32 bytes).
# By default a key file is created at <data dir>/key with mode 0600.
# FLUENTDB_SECRET=

# AI assistant — provider: ollama (local model) | gemini | none.
# Unset: Gemini when GEMINI_API_KEY is set, otherwise the assistant is disabled.
# AI_PROVIDER=ollama

# Local model via Ollama (https://ollama.com) — `ollama pull qwen2.5-coder:3b`
# OLLAMA_MODEL=qwen2.5-coder:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=16384

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Docker socket override (defaults to /var/run/docker.sock or $DOCKER_HOST)
# DOCKER_HOST=
